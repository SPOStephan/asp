{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "framework": "vite",
  "rewrites": [
    { "source": "/robots.txt", "destination": "/api/site?file=robots" },
    { "source": "/sitemap.xml", "destination": "/api/site?file=sitemap" },
    { "source": "/llms.txt", "destination": "/api/site?file=llms" },
    { "source": "/llms-full.txt", "destination": "/api/site?file=llms-full" },
    { "source": "/:path((?!api/|assets/).*)", "destination": "/api/site?path=/:path" }
  ]
}

# Browser build (Vite). Required on every Vercel project that serves the app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Accepted aliases if Vercel only inherited the unprefixed names
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server: Bunny upload (/api/bunny-upload). Never prefix the storage key with VITE_.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_CDN_URL=https://your-pullzone.b-cdn.net

# Other names we also accept for Bunny
# BUNNY_ZONE / BUNNY_API_KEY / BUNNY_CDN_HOSTNAME / BUNNY_PULL_ZONE_URL

SUPABASE_SERVICE_ROLE_KEY=
